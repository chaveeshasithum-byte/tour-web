datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum PlanningMode {
  BUDGET
  NO_BUDGET
}

enum TripStatus {
  PENDING_REVIEW
  UNDER_REVIEW
  CONSULTATION_SCHEDULED
  PRICE_CONFIRMED
  DEPOSIT_RECEIVED
  CONFIRMED
  CANCELLED
}

enum VehicleType {
  CAR
  VAN
  SUV
}

model Customer {
  id          String   @id @default(cuid())
  fullName    String
  email       String
  phone       String?
  country     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  trips       Trip[]
}

model Trip {
  id                  String       @id @default(cuid())
  tripReference       String       @unique // e.g. SL-10001
  customerId          String?
  customer            Customer?    @relation(fields: [customerId], references: [id])
  
  planningMode        PlanningMode @default(NO_BUDGET)
  currency            String       @default("USD")
  targetBudget        Float?
  
  arrivalDate         DateTime
  departureDate       DateTime
  totalDays           Int
  totalNights         Int
  adults              Int          @default(2)
  children            Int          @default(0)
  roomsCount          Int          @default(1)
  
  selectedDestinations String[]    // Destination slugs / names
  
  vehicleId           String?
  vehicle             Vehicle?     @relation(fields: [vehicleId], references: [id])
  vehicleTotalCost    Float        @default(0)
  
  hotelSelections     TripHotelSelection[]
  experienceSelections TripExperienceSelection[]
  
  estimatedTotalCost  Float
  remainingBudget     Float?
  
  status              TripStatus   @default(PENDING_REVIEW)
  notes               String?
  internalNotes       String?
  
  consultationDate    DateTime?
  consultationLink    String?
  
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

model Destination {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  tagline          String
  description      String
  heroImage        String
  recommendedStay  String
  highlights       String[]
  hotels           Hotel[]
  experiences      Experience[]
  createdAt        DateTime @default(now())
}

model Hotel {
  id              String   @id @default(cuid())
  destinationId   String
  destination     Destination @relation(fields: [destinationId], references: [id])
  name            String
  starRating      Int      @default(4)
  location        String
  roomType        String
  pricePerNightUSD Float
  amenities       String[]
  imageUrl        String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  selections      TripHotelSelection[]
}

model TripHotelSelection {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id])
  nights    Int      @default(1)
  rooms     Int      @default(1)
  priceSnapshot Float
}

model Vehicle {
  id            String      @id @default(cuid())
  type          VehicleType
  name          String
  tagline       String
  capacityAdults Int
  capacityLuggage Int
  dailyRateUSD  Float
  features      String[]
  imageUrl      String
  trips         Trip[]
}

model Experience {
  id              String      @id @default(cuid())
  destinationId   String?
  destination     Destination? @relation(fields: [destinationId], references: [id])
  category        String      // Wildlife, Beaches, Adventure, Culture, Food, Wellness
  name            String
  region          String
  duration        String
  pricePerPersonUSD Float
  description     String
  imageUrl        String
  selections      TripExperienceSelection[]
}

model TripExperienceSelection {
  id           String     @id @default(cuid())
  tripId       String
  trip         Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  experienceId String
  experience   Experience @relation(fields: [experienceId], references: [id])
  participants Int        @default(2)
  priceSnapshot Float
}
